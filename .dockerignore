# ==============================================================================
# Tệp loại trừ khi dựng Docker cho UniLake AI
# Ngăn sao chép các tệp không cần thiết và dữ liệu nhạy cảm vào image
# ==============================================================================

# Git và quản lý phiên bản
.git/
.gitignore
.github/

# Biến môi trường và thông tin bí mật (không đưa .env vào image để bảo mật)
.env
.env.local
.env.*.local
!.env.example

# Môi trường ảo và bộ nhớ đệm Python
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node.js và sản phẩm dựng frontend
node_modules/
frontend/node_modules/
.next/
frontend/.next/
.pnpm-store/
out/
dist/
build/
*.tsbuildinfo
.lighthouseci/

# Tệp của IDE và trình soạn thảo
.vscode/
.idea/
.crossnote/
*.swp
*.swo

# Siêu dữ liệu của hệ điều hành
.DS_Store
Thumbs.db

# Tệp cơ sở dữ liệu và lưu trữ
data/
*.parquet
*.duckdb
*.db
*.sqlite
*.sqlite3

# Nhật ký và tệp tạm
*.log
logs/
tmp/
temp/

# Tài liệu và notebook (không cần trong container production)
docs/
notebooks/
.ipynb_checkpoints/
README.md
SETUP.md
CONTRIBUTING.md
