{
  "openapi": "3.1.0",
  "info": {
    "title": "UniLake AI API",
    "description": "UniLake AI - Multi-source Data Lake Platform API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/governance/catalog": {
      "get": {
        "tags": [
          "governance"
        ],
        "summary": "Get Catalog",
        "description": "Return catalog entries generated from registered domain metadata.",
        "operationId": "get_catalog_api_v1_governance_catalog_get",
        "parameters": [
          {
            "name": "domain_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Domain Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogEntry"
                  },
                  "title": "Response Get Catalog Api V1 Governance Catalog Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nlq/ask": {
      "post": {
        "tags": [
          "nlq"
        ],
        "summary": "Ask Nlq",
        "description": "Run the NLQ flow from intent parsing to read-only execution.",
        "operationId": "ask_nlq_api_v1_nlq_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NaturalLanguageQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NaturalLanguageQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Read Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogEntry": {
        "properties": {
          "domain_id": {
            "type": "string",
            "title": "Domain Id"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset"
          },
          "layer": {
            "$ref": "#/components/schemas/DataLayer"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "domain_id",
          "dataset",
          "layer",
          "schema_version",
          "description",
          "fields"
        ],
        "title": "CatalogEntry",
        "description": "Catalog projection built from a registered domain dataset."
      },
      "DataLayer": {
        "type": "string",
        "enum": [
          "bronze",
          "silver",
          "gold"
        ],
        "title": "DataLayer",
        "description": "Logical data-lake layers exposed to domain implementations."
      },
      "FieldDefinition": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "data_type": {
            "type": "string",
            "title": "Data Type"
          },
          "nullable": {
            "type": "boolean",
            "title": "Nullable",
            "default": true
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "data_type"
        ],
        "title": "FieldDefinition",
        "description": "Portable field metadata used by catalog and NLQ consumers."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NaturalLanguageQueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "NaturalLanguageQueryRequest",
        "description": "User question submitted to the NLQ engine."
      },
      "NaturalLanguageQueryResponse": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "NaturalLanguageQueryResponse",
        "description": "NLQ response payload."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}