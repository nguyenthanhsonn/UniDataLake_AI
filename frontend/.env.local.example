# Chỉ dùng ở server (route handler / middleware), trình duyệt không thấy
API_BASE_URL=http://localhost:8000/api/v1
# Trình duyệt gọi qua proxy cùng origin (xem bước 6)
NEXT_PUBLIC_API_BASE_URL=/api/proxy
# Trang đăng nhập gọi thẳng backend; có hay không có hậu tố /api/v1 đều được
NEXT_PUBLIC_API_URL=http://localhost:8000
